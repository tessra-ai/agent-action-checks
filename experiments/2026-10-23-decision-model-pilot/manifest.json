  "specs": {
    "D": {
      "arm": "D",
      "combination": "mean of policy_ok and matches_request p_yes (frozen.scalar_score)",
      "inputs": [
        "policy_ok",
        "matches_request"
      ],
      "threshold": "learner.fit_threshold at catch target 0.95 on revealed rows"
    },
    "DC": {
      "arm": "DC",
      "combination": "minimum assessment over the concepts with applicable >= 0.5 and an assessment; not_forbidden not met therefore scores near 0; no applicable concept scores 0 (escalates)",
      "concepts": [
        "actor_identified",
        "action_requested",
        "terms_disclosed",
        "consent_obtained",
        "ownership_authority",
        "prerequisites_satisfied",
        "harm_avoided",
        "evidence_certain",
        "not_forbidden"
      ],
      "inputs": "the shared concept assessments (concepts.ConceptAssessment)",
      "learning": "none",
      "threshold": "learner.fit_threshold at catch target 0.95 on revealed rows"
    },
    "G1": {
      "algorithm": {
        "C": 1.0,
        "class_weight": "balanced",
        "max_iter": 1000,
        "model": "sklearn.linear_model.LogisticRegression",
        "penalty": "l2 (the default)",
        "random_state": 0,
        "solver": "lbfgs"
      },
      "arm": "G1",
      "calibration": "none: the logistic output is p_ok",
      "cold_start": "fewer than min_class revealed rows of either class: no model, ASK everything",
      "input_rules": [
        "per concept: applicable = P(applies); assessed = assessment x applicable; missing = 1 when the assessment is missing; confidence = 1 - normalized entropy",
        "impact and reversible one-hot, from the policy's frozen action metadata",
        "never the action, the domain, or an action-specific rubric answer"
      ],
      "inputs": [
        "actor_identified:applicable",
        "actor_identified:assessed",
        "actor_identified:missing",
        "actor_identified:confidence",
        "action_requested:applicable",
        "action_requested:assessed",
        "action_requested:missing",
        "action_requested:confidence",
        "terms_disclosed:applicable",
        "terms_disclosed:assessed",
        "terms_disclosed:missing",
        "terms_disclosed:confidence",
        "consent_obtained:applicable",
        "consent_obtained:assessed",
        "consent_obtained:missing",
        "consent_obtained:confidence",
        "ownership_authority:applicable",
        "ownership_authority:assessed",
        "ownership_authority:missing",
        "ownership_authority:confidence",
        "prerequisites_satisfied:applicable",
        "prerequisites_satisfied:assessed",
        "prerequisites_satisfied:missing",
        "prerequisites_satisfied:confidence",
        "harm_avoided:applicable",
        "harm_avoided:assessed",
        "harm_avoided:missing",
        "harm_avoided:confidence",
        "reversible:applicable",
        "reversible:assessed",
        "reversible:missing",
        "reversible:confidence",
        "evidence_certain:applicable",
        "evidence_certain:assessed",
        "evidence_certain:missing",
        "evidence_certain:confidence",
        "not_forbidden:applicable",
        "not_forbidden:assessed",
        "not_forbidden:missing",
        "not_forbidden:confidence",
        "impact=none",
        "impact=service",
        "impact=financial",
        "reversible=yes",
        "reversible=partly",
        "reversible=no"
      ],
      "min_class": 3,
      "missing_values": "a missing assessment is 0 with its missing indicator 1; a missing confidence is 0; a write with no ok score row has no features, fails closed (ASK) and counts as incomplete",
      "model_version": "sha256 of (this spec, the sorted training write ids)",
      "scaling": "z-score per input with the mean and standard deviation of the revealed rows",
      "seed": 0,
      "target": "1 if the policy verdict is ALLOW (automatic execution correct), 0 if ASK or DENY (escalation correct); UNKNOWN verdicts are left out",
      "threshold": "learner.fit_threshold at catch target 0.95 over out-of-fold p_ok on the revealed rows: up to 5 folds by scenario family (learner.group_folds, seed 0); a fold whose training part lacks MIN_CLASS rows of either class is predicted by the model fitted on all revealed rows",
      "version": "g1-1"
    },
